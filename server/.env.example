# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=1234
DB_NAME=mini-crm

# Optional full connection string alternative:
# DATABASE_URL=postgres://postgres:1234@localhost:5433/mini-crm

# JWT Secret (Required for access and refresh tokens)
JWT_SECRET=your-secure-jwt-secret-key-here

# CORS: Allowed origin for Next.js client
CORS_ORIGIN=http://localhost:3001
