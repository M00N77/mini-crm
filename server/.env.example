# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=1234
DB_NAME=mini-crm

# Optional full connection string alternative:
# DATABASE_URL=postgres://postgres:1234@localhost:5432/mini-crm

# JWT Secret (Required for access and refresh tokens)
JWT_SECRET=super-secret-jwt-key-change-in-production

# CORS & Client Navigation
CORS_ORIGIN=http://localhost:3001
CLIENT_REDIRECT_URL=http://localhost:3001/dashboard

# Google OAuth 2.0 (Google Cloud Console Credentials)
oauth2Endpoint=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
